# Send "/" to the visitor's language. Netlify checks the nf_lang cookie first,
# then the browser's Accept-Language header.
/  /nl/  302!  Language=nl
/  /de/  302!  Language=de
/  /sv/  302!  Language=sv
/  /fi/  302!  Language=fi
/  /no/  302!  Language=no,nb,nn
/  /fr/  302!  Language=fr
/  /da/  302!  Language=da
/  /th/  302!  Language=th
/  /zh/  302!  Language=zh
/  /ru/  302!  Language=ru
/  /en/  302!

