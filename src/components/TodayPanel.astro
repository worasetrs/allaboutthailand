---
import { CALENDAR } from '../data/calendar';
import { t, langInfo, type Lang } from '../i18n';
interface Props { lang: Lang }
const { lang } = Astro.props;
const d = t(lang);
const holidays = CALENDAR.filter((c) => c.holiday).map((c) => ({ date: c.date, name: d.calendar.names[c.name as keyof typeof d.calendar.names] }));
const cfg = { holidays, locale: langInfo(lang).locale, be: d.today.be, unavailable: d.today.unavailable, wx: d.today.wx, bands: d.today.aqiBands };
---
<aside class="today" aria-label={d.today.title} data-pagefind-ignore>
  <div class="eyebrow" style="color:var(--gold)">{d.today.title}</div>
  <div class="row"><span class="k">{d.today.date}</span><span class="v" id="t-date">–</span></div>
  <div class="row"><span class="k">{d.today.fx}</span><span class="v" id="t-fx">{d.today.loading}</span></div>
  <div class="row"><span class="k">{d.today.weather}</span><span class="v" id="t-wx">{d.today.loading}</span></div>
  <div class="row"><span class="k">{d.today.aqi}</span><span class="v" id="t-aqi">{d.today.loading}</span></div>
  <div class="row"><span class="k">{d.today.holiday}</span><span class="v" id="t-hol">–</span></div>
  <p class="src">{d.today.credit}: <a href="https://www.exchangerate-api.com" rel="noopener">Rates by Exchange Rate API</a> · <a href="https://open-meteo.com/" rel="noopener">Open-Meteo</a></p>
</aside>

<script is:inline define:vars={{ cfg }}>
(() => {
  const TZ = 'Asia/Bangkok';
  const $ = (id) => document.getElementById(id);
  const now = new Date();
  const ymd = new Intl.DateTimeFormat('en-CA', { timeZone: TZ }).format(now);
  const y = Number(ymd.slice(0, 4));
  const fmt = (d) => new Intl.DateTimeFormat(cfg.locale, { timeZone: TZ, weekday: 'short', day: 'numeric', month: 'short' }).format(d);
  $('t-date').textContent = `${fmt(now)} ${y} · ${cfg.be} ${y + 543}`;

  const next = cfg.holidays.find((h) => h.date >= ymd);
  if (next) $('t-hol').textContent = fmt(new Date(next.date + 'T12:00:00+07:00')) + ' · ' + next.name;

  async function cached(key, url, maxAgeMin) {
    try {
      const raw = localStorage.getItem(key);
      if (raw) { const c = JSON.parse(raw); if (Date.now() - c.t < maxAgeMin * 60000) return c.v; }
    } catch (e) {}
    const r = await fetch(url);
    if (!r.ok) throw new Error(String(r.status));
    const v = await r.json();
    try { localStorage.setItem(key, JSON.stringify({ t: Date.now(), v })); } catch (e) {}
    return v;
  }
  const fail = (id) => { $(id).textContent = cfg.unavailable; };

  cached('aat-fx', 'https://open.er-api.com/v6/latest/USD', 60)
    .then((d) => { $('t-fx').textContent = '฿ ' + d.rates.THB.toFixed(2); })
    .catch(() => fail('t-fx'));

  const wx = (c) => c === 0 || c === 1 ? cfg.wx.clear : c === 2 ? cfg.wx.partly : c === 3 ? cfg.wx.cloudy : c <= 48 ? cfg.wx.fog : c <= 57 ? cfg.wx.drizzle : c <= 67 ? cfg.wx.rain : c <= 82 ? cfg.wx.showers : cfg.wx.storm;
  cached('aat-wx', 'https://api.open-meteo.com/v1/forecast?latitude=13.75&longitude=100.50&current=temperature_2m,weather_code&timezone=Asia%2FBangkok', 30)
    .then((d) => { $('t-wx').textContent = Math.round(d.current.temperature_2m) + '°C · ' + wx(d.current.weather_code); })
    .catch(() => fail('t-wx'));

  const band = (a) => cfg.bands[a <= 50 ? 0 : a <= 100 ? 1 : a <= 150 ? 2 : a <= 200 ? 3 : 4];
  cached('aat-aqi', 'https://air-quality-api.open-meteo.com/v1/air-quality?latitude=13.75&longitude=100.50&current=us_aqi,pm2_5&timezone=Asia%2FBangkok', 30)
    .then((d) => { const a = Math.round(d.current.us_aqi); $('t-aqi').textContent = `AQI ${a} · ${band(a)}`; })
    .catch(() => fail('t-aqi'));
})();
</script>
