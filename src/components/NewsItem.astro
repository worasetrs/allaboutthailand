---
import type { NewsItem } from '../lib/content';
import { t, href, formatDate, type Lang } from '../i18n';
interface Props { item: NewsItem; lang: Lang }
const { item, lang } = Astro.props;
const d = t(lang);
---
<a class:list={['news-item', item.severity === 'urgent' && 'urgent']} href={href(lang, `/news/${item.slug}/`)} data-category={item.category}>
  <span class:list={['tag', item.severity !== 'info' && item.severity]}>{item.severity === 'urgent' ? '⚠ ' : ''}{d.categories[item.category]}</span>
  <h3>{item.title}</h3>
  <p>{item.summary}</p>
  <span class="meta">{formatDate(item.publishedAt, lang)}{item.affects.length > 0 && ` · ${d.article.affects}: ${item.affects.join(', ')}`}</span>
</a>
