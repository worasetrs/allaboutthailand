---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import NewsItem from '../../components/NewsItem.astro';
import Briefing from '../../components/Briefing.astro';
import { CATEGORY_LABEL } from '../../data/site';

const news = (await getCollection('news')).sort((a, b) => +b.data.publishedAt - +a.data.publishedAt);
const cats = [...new Set(news.map((n) => n.data.category))];
---
<Base title="News for foreigners" description="Thailand news that affects foreigners: visa and immigration rules, travel advisories, economy and events, each linked to its source.">
  <div class="wrap narrow">
    <div class="article-head">
      <div class="eyebrow">News</div>
      <h1>News for foreigners in Thailand</h1>
      <p class="muted">Rule changes, advisories and events, explained with what they mean for you. <a href="/rss.xml">RSS feed</a></p>
    </div>
    <div class="filters" role="group" aria-label="Filter by topic" data-pagefind-ignore>
      <button type="button" aria-pressed="true" data-filter="all">All</button>
      {cats.map((c) => <button type="button" aria-pressed="false" data-filter={c}>{CATEGORY_LABEL[c]}</button>)}
    </div>
    <div class="news-list" id="news-list">{news.map((n) => <NewsItem item={n} />)}</div>
  </div>
  <Briefing />
  <script>
    const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const items = document.querySelectorAll<HTMLElement>('#news-list [data-category]');
    buttons.forEach((b) => b.addEventListener('click', () => {
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      const f = b.dataset.filter;
      items.forEach((i) => { i.hidden = f !== 'all' && i.dataset.category !== f; });
    }));
  </script>
</Base>
