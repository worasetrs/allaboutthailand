---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { CATEGORY_LABEL, SITE } from '../../data/site';
import { formatDate } from '../../lib/format';

export async function getStaticPaths() {
  const news = await getCollection('news');
  return news.map((n) => ({ params: { slug: n.id }, props: { item: n } }));
}
const { item } = Astro.props;
const { Content } = await render(item);
const d = item.data;
const url = new URL(Astro.url.pathname, Astro.site).toString();
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'NewsArticle',
  headline: d.title,
  description: d.summary,
  datePublished: d.publishedAt.toISOString(),
  dateModified: (d.updatedAt ?? d.publishedAt).toISOString(),
  mainEntityOfPage: url,
  image: [new URL('/og-default.png', Astro.site).toString()],
  author: { '@type': 'Organization', name: SITE.name },
  publisher: { '@type': 'Organization', name: SITE.name },
};
---
<Base title={d.title} description={d.summary} type="article" jsonLd={jsonLd}>
  <article class="wrap narrow">
    <div class="article-head">
      <a class="crumb" href="/news/" data-pagefind-ignore>‹ News</a>
      <span class:list={['tag', d.severity !== 'info' && d.severity]}>{CATEGORY_LABEL[d.category]}</span>
      <h1>{d.title}</h1>
      <p class="muted">{d.summary}</p>
      <span class="meta">
        Published {formatDate(d.publishedAt)}{d.updatedAt && ` · Updated ${formatDate(d.updatedAt)}`}
        {d.affects.length > 0 && ` · Affects: ${d.affects.join(', ')}`}
      </span>
    </div>
    <div class="prose"><Content /></div>
    <aside class="sources">
      <b>Sources</b>
      <ul>{d.sources.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.name}</a></li>)}</ul>
    </aside>
    <div class="toolbar" data-pagefind-ignore>
      <a class="btn ghost" href="/news/">More news</a>
      <a class="btn ghost" href={`/about/?page=${encodeURIComponent(Astro.url.pathname)}#contact`}>Report a correction</a>
    </div>
  </article>
</Base>
