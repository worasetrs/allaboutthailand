---
import Base from '../layouts/Base.astro';
---
<Base lang="en" path="/404/" title="Page not found" noindex>
  <div class="wrap narrow">
    <div class="article-head" style="padding-block:64px">
      <div class="eyebrow">404</div>
      <h1>Mai pen rai. This page is not here.</h1>
      <p class="muted">The link may be old. Try searching, or start from the guides.</p>
      <div class="toolbar"><a class="btn" href="/en/search/">Search</a><a class="btn ghost" href="/en/guides/">All guides</a></div>
    </div>
  </div>
</Base>
