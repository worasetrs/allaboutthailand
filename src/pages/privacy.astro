---
import Base from '../layouts/Base.astro';
---
<Base title="Privacy" description="What data All About Thailand collects and why.">
  <div class="wrap narrow">
    <div class="article-head"><h1>Privacy</h1></div>
    <div class="prose" style="padding-bottom:48px">
      <ul>
        <li><b>No tracking cookies.</b> We do not use advertising or tracking cookies.</li>
        <li><b>Forms.</b> If you subscribe or contact us, we store your email and message with our host, Netlify, only to reply or to send the briefing. Ask us to delete it at any time using the <a href="/about/#contact">contact form</a>.</li>
        <li><b>Your device.</b> The currency rates, weather and the address you type into "Show to driver" are saved only in your own browser so the tools work offline. They are never sent to us.</li>
        <li><b>Third-party data.</b> Your browser loads exchange rates from Exchange Rate API, weather and air quality from Open-Meteo, and fonts from Google Fonts.</li>
      </ul>
    </div>
  </div>
</Base>
