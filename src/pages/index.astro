---
// Netlify sends visitors from "/" to their language (see public/_redirects).
// This page is the fallback: it redirects in the browser and lists every language.
import '../styles/global.css';
import { LANGS } from '../i18n';
import { SITE } from '../data/site';
const abs = (p: string) => new URL(p, Astro.site).toString();
const codes = LANGS.map((l) => l.code);
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{SITE.name}</title>
  <meta name="description" content="The practical guide to Thailand for foreigners, in 11 languages." />
  <link rel="canonical" href={abs('/en/')} />
  {LANGS.map((l) => <link rel="alternate" hreflang={l.hreflang} href={abs(`/${l.code}/`)} />)}
  <link rel="alternate" hreflang="x-default" href={abs('/')} />
  <link rel="icon" href="/favicon-32.png" type="image/png" />
  <meta name="theme-color" content="#0a2c58" />
  <script is:inline define:vars={{ codes }}>
    (function () {
      var m = document.cookie.match(/(?:^|; )nf_lang=([a-z]{2})/);
      var pick = m && codes.indexOf(m[1]) >= 0 ? m[1] : null;
      if (!pick) {
        var prefs = navigator.languages || [navigator.language || 'en'];
        for (var i = 0; i < prefs.length && !pick; i++) {
          var c = String(prefs[i]).toLowerCase().slice(0, 2);
          if (c === 'nb' || c === 'nn') c = 'no';
          if (codes.indexOf(c) >= 0) pick = c;
        }
      }
      location.replace('/' + (pick || 'en') + '/');
    })();
  </script>
</head>
<body style="background:var(--navy);color:var(--on-navy);min-height:100vh;display:grid;place-items:center">
  <main class="wrap" style="padding-block:48px;display:grid;gap:20px;justify-items:center;text-align:center">
    <img src="/logo-mark.png" alt="" width="96" height="96" />
    <img src="/wordmark-light.png" alt="allaboutthailand" width="266" height="42" />
    <ul style="list-style:none;padding:0;margin:0;display:flex;flex-wrap:wrap;gap:8px;justify-content:center;max-width:560px">
      {LANGS.map((l) => <li><a href={`/${l.code}/`} hreflang={l.hreflang} lang={l.hreflang} style="color:var(--on-navy);border:1px solid rgba(255,255,255,.3);border-radius:999px;padding:8px 16px;display:inline-block;text-decoration:none">{l.name}</a></li>)}
    </ul>
  </main>
</body>
</html>
