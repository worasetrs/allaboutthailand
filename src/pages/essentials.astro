---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { EMERGENCY } from '../data/site';
import { PHRASES } from '../data/phrases';
const CURRENCIES = ['USD', 'EUR', 'GBP', 'CNY', 'JPY', 'KRW', 'INR', 'AUD', 'SGD', 'MYR', 'RUB', 'CAD'];
---
<Base title="Essentials" description="Emergency numbers, a live baht converter, a 'show to driver' address screen and Thai phrases with audio. Works offline once opened.">
  <div class="wrap narrow">
    <div class="article-head">
      <div class="eyebrow">Essentials · works offline</div>
      <h1>Your Thailand toolkit</h1>
      <p class="muted">Open this page once while online and it keeps working without a connection.</p>
    </div>

    <section class="block" id="sos" style="padding-block:16px">
      <h2 style="margin-bottom:12px">Emergency numbers</h2>
      <div class="call-list">
        {EMERGENCY.map((e) => <a class="call" href={`tel:${e.number}`}><span><b>{e.label}</b><small>{e.note}</small></span><span class="num">{e.number}</span></a>)}
      </div>
    </section>

    <section class="block" id="converter" style="padding-block:24px">
      <div class="tool">
        <h2>Currency converter</h2>
        <div class="conv">
          <div class="field"><label for="conv-amt">Amount</label><input id="conv-amt" type="text" inputmode="decimal" value="100" autocomplete="off" /></div>
          <div class="field"><label for="conv-cur">Currency</label>
            <select id="conv-cur">{CURRENCIES.map((c) => <option value={c}>{c}</option>)}</select>
          </div>
        </div>
        <div><div class="conv-out" id="conv-out" aria-live="polite">–</div><div class="meta" id="conv-rev"></div></div>
        <p class="meta" id="conv-src">Rates by <a href="https://www.exchangerate-api.com" rel="noopener">Exchange Rate API</a>. Banks and exchange booths use their own rates.</p>
      </div>
    </section>

    <section class="block" id="driver" style="padding-block:24px">
      <div class="tool">
        <h2>Show to driver</h2>
        <p class="muted">Paste your hotel's address in Thai (from your booking or Google Maps), then show the big-text screen to a taxi or tuk-tuk driver.</p>
        <div class="field"><label for="drv-addr">Address in Thai</label><textarea id="drv-addr" placeholder="เช่น โรงแรม... ถนน... เขต..."></textarea></div>
        <label style="display:flex;gap:10px;align-items:center;font-weight:500"><input id="drv-meter" type="checkbox" style="width:22px;min-height:22px" checked /> Add "please use the meter"</label>
        <button class="btn" type="button" id="drv-show">Show full screen</button>
      </div>
      <div class="driver-screen" id="drv-screen" hidden role="dialog" aria-modal="true" aria-label="Address for driver">
        <div class="lbl" lang="th">กรุณาไปส่งที่</div>
        <div class="addr" lang="th" id="drv-text"></div>
        <div class="lbl" lang="th" id="drv-meter-txt">กรุณาเปิดมิเตอร์ด้วยครับ/ค่ะ</div>
        <button type="button" id="drv-close">Close</button>
      </div>
    </section>

    <section class="block" id="phrases" style="padding-block:24px 48px">
      <h2 style="margin-bottom:6px">Thai phrases</h2>
      <p class="muted" style="margin-bottom:14px">Men end polite sentences with <i>khrap</i>, women with <i>kha</i>. Tap ▶ to hear it.</p>
      <div class="phrases">
        {PHRASES.map((p) => (
          <div class="phrase">
            <span class="th" lang="th">{p.th}</span>
            <span class="say">{p.say}</span>
            <span class="en">{p.en}</span>
            <button class="play" type="button" data-speak={p.speak} aria-label={`Play: ${p.en}`}><Icon name="play" size={18} /></button>
          </div>
        ))}
      </div>
      <p class="meta" id="tts-note" hidden>Your device has no Thai voice installed, so audio is unavailable.</p>
    </section>
  </div>

  <script>
    // Converter
    const amt = document.getElementById('conv-amt') as HTMLInputElement;
    const cur = document.getElementById('conv-cur') as HTMLSelectElement;
    const out = document.getElementById('conv-out')!;
    const rev = document.getElementById('conv-rev')!;
    let rates: Record<string, number> | null = null;
    let updated = '';
    const fmt = (n: number) => n.toLocaleString('en-US', { maximumFractionDigits: 2 });
    function render() {
      if (!rates) return;
      const a = parseFloat(amt.value.replace(/,/g, '')) || 0;
      const perUnit = 1 / rates[cur.value]; // THB per 1 unit of currency
      out.textContent = `${fmt(a)} ${cur.value} = ฿ ${fmt(a * perUnit)}`;
      rev.textContent = `1 ${cur.value} = ฿ ${fmt(perUnit)} · ฿ 100 = ${fmt(100 / perUnit)} ${cur.value}${updated ? ' · updated ' + updated : ''}`;
    }
    async function loadRates() {
      try {
        const cached = localStorage.getItem('aat-fx-thb');
        if (cached) { const c = JSON.parse(cached); rates = c.rates; updated = c.updated; render(); if (Date.now() - c.t < 3600000) return; }
      } catch {}
      try {
        const r = await fetch('https://open.er-api.com/v6/latest/THB');
        const d = await r.json();
        rates = d.rates; updated = new Date(d.time_last_update_unix * 1000).toLocaleDateString('en-GB', { day: 'numeric', month: 'short' });
        try { localStorage.setItem('aat-fx-thb', JSON.stringify({ t: Date.now(), rates, updated })); } catch {}
        render();
      } catch {
        if (!rates) out.textContent = 'Rates unavailable offline. Connect once to load them.';
      }
    }
    amt.addEventListener('input', render);
    cur.addEventListener('change', render);
    loadRates();

    // Show to driver
    const addr = document.getElementById('drv-addr') as HTMLTextAreaElement;
    const screen = document.getElementById('drv-screen')!;
    const meter = document.getElementById('drv-meter') as HTMLInputElement;
    try { addr.value = localStorage.getItem('aat-driver-addr') || ''; } catch {}
    addr.addEventListener('input', () => { try { localStorage.setItem('aat-driver-addr', addr.value); } catch {} });
    let lock: any = null;
    document.getElementById('drv-show')!.addEventListener('click', async () => {
      if (!addr.value.trim()) { addr.focus(); return; }
      document.getElementById('drv-text')!.textContent = addr.value.trim();
      document.getElementById('drv-meter-txt')!.hidden = !meter.checked;
      screen.hidden = false;
      try { await document.documentElement.requestFullscreen?.(); } catch {}
      try { lock = await (navigator as any).wakeLock?.request('screen'); } catch {}
    });
    document.getElementById('drv-close')!.addEventListener('click', async () => {
      screen.hidden = true;
      try { if (document.fullscreenElement) await document.exitFullscreen(); } catch {}
      try { await lock?.release(); } catch {}
    });

    // Phrases audio
    const synth = window.speechSynthesis;
    const thaiVoice = () => synth?.getVoices().find((v) => v.lang.toLowerCase().startsWith('th'));
    document.querySelectorAll<HTMLButtonElement>('[data-speak]').forEach((b) => b.addEventListener('click', () => {
      if (!synth) return;
      const voice = thaiVoice();
      if (!voice) { document.getElementById('tts-note')!.hidden = false; }
      const u = new SpeechSynthesisUtterance(b.dataset.speak);
      u.lang = 'th-TH'; u.rate = 0.85; if (voice) u.voice = voice;
      synth.cancel(); synth.speak(u);
    }));
  </script>
</Base>
