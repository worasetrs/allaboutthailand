---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { PATHS, SITE } from '../../data/site';
import { formatDate, daysSince, FRESH_DAYS, isoDate } from '../../lib/format';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((g) => ({ params: { slug: g.id }, props: { guide: g } }));
}
const { guide } = Astro.props;
const { Content } = await render(guide);
const d = guide.data;
const stale = daysSince(d.lastChecked) > FRESH_DAYS;
const path = PATHS[d.path];
const url = new URL(Astro.url.pathname, Astro.site).toString();
const jsonLd = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: d.title,
    description: d.summary,
    dateModified: isoDate(d.lastChecked),
    mainEntityOfPage: url,
    publisher: { '@type': 'Organization', name: SITE.name },
    citation: d.sources.map((s) => s.url),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Guides', item: new URL('/guides/', Astro.site).toString() },
      { '@type': 'ListItem', position: 2, name: d.title, item: url },
    ],
  },
];
---
<Base title={d.title} description={d.summary} type="article" jsonLd={jsonLd}>
  <article class="wrap narrow">
    <div class="article-head">
      <a class="crumb" href={`/guides/#${d.path}`} data-pagefind-ignore>‹ {path.title}</a>
      <h1>{d.title}</h1>
      <p class="muted">{d.summary}</p>
      <span class:list={['fresh', stale && 'stale']} data-pagefind-ignore>
        {stale ? `Being re-checked · last checked ${formatDate(d.lastChecked)}` : `✓ Checked ${formatDate(d.lastChecked)}`}
      </span>
    </div>

    {d.tldr && (
      <dl class="tldr">
        <div><dt>Who</dt><dd>{d.tldr.who}</dd></div>
        <div><dt>Cost</dt><dd>{d.tldr.cost}</dd></div>
        <div><dt>Where</dt><dd>{d.tldr.where}</dd></div>
        {d.tldr.time && <div><dt>Time</dt><dd>{d.tldr.time}</dd></div>}
      </dl>
    )}

    <div class="prose"><Content /></div>

    <aside class="sources">
      <b>Sources</b>
      <ul>{d.sources.map((s) => <li><a href={s.url} rel="noopener" target="_blank">{s.name}</a></li>)}</ul>
    </aside>

    <div class="toolbar" data-pagefind-ignore>
      <button class="btn ghost" type="button" data-share>Share this guide</button>
      <a class="btn ghost" href={`/about/?page=${encodeURIComponent(Astro.url.pathname)}#contact`}>Report a correction</a>
    </div>
    <p class="disclaimer" data-pagefind-ignore>Rules in Thailand change often and can differ between immigration offices. Confirm with the official source before you act.</p>
  </article>
  <script>
    document.querySelectorAll<HTMLButtonElement>('[data-share]').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const data = { title: document.title, url: location.href };
        try {
          if (navigator.share) { await navigator.share(data); return; }
          await navigator.clipboard.writeText(location.href);
          btn.textContent = 'Link copied';
        } catch { /* user cancelled */ }
      });
    });
  </script>
</Base>
