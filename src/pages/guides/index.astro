---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { PATHS } from '../../data/site';
import { formatDate } from '../../lib/format';

const guides = (await getCollection('guides')).sort((a, b) => a.data.order - b.data.order);
const groups = Object.entries(PATHS)
  .map(([key, p]) => ({ key, ...p, items: guides.filter((g) => g.data.path === key) }))
  .filter((g) => g.items.length > 0);
---
<Base title="Guides" description="Step-by-step guides for foreigners in Thailand: visas, arrival, money, healthcare, renting, retirement and etiquette.">
  <div class="wrap narrow">
    <div class="article-head">
      <div class="eyebrow">Guides</div>
      <h1>Guides for foreigners in Thailand</h1>
      <p class="muted">Each guide lists its official sources and the date we last checked it.</p>
    </div>
    {groups.map((g) => (
      <section class="block" id={g.key} style="padding-block:20px">
        <div class="eyebrow" style="color:var(--jade)">{g.tag}</div>
        <h2 style="margin-bottom:8px">{g.title}</h2>
        <div class="news-list">
          {g.items.map((item) => (
            <a class="news-item" href={`/guides/${item.id}/`}>
              <h3>{item.data.title}</h3>
              <p>{item.data.summary}</p>
              <span class="meta">Checked {formatDate(item.data.lastChecked)}{item.data.offline && ' · Works offline'}</span>
            </a>
          ))}
        </div>
      </section>
    ))}
  </div>
</Base>
