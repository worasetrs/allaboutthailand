---
import Base from '../layouts/Base.astro';
---
<Base title="About and sources" description="How All About Thailand researches, sources and corrects its guides and news for foreigners.">
  <div class="wrap narrow">
    <div class="article-head">
      <div class="eyebrow">About</div>
      <h1>About All About Thailand</h1>
    </div>
    <div class="prose">
      <p>All About Thailand explains the practical side of visiting and living in Thailand: entry rules, visas, money, health, transport and culture, plus the news that affects foreigners.</p>
      <h2>How we work</h2>
      <ul>
        <li><b>Official sources first.</b> Every guide and story links to the Royal Gazette, a government agency, an embassy, or a reputable news outlet or law firm reporting on them.</li>
        <li><b>Dated checks.</b> Each guide shows the date we last checked it. Guides older than 90 days are marked as being re-checked.</li>
        <li><b>Plain English.</b> We explain what a change means for you and what to do next.</li>
        <li><b>Not legal advice.</b> Immigration offices can apply rules differently. For your own case, ask the Immigration Bureau, a Thai embassy or a licensed lawyer.</li>
      </ul>
      <h2 id="contact">Report a correction or contact us</h2>
      <p>Found something out of date? Tell us and we will check it.</p>
    </div>
    <form class="stack" name="contact" method="POST" action="/thanks/" data-netlify="true" netlify-honeypot="bot-field" style="padding-block:16px 48px">
      <input type="hidden" name="form-name" value="contact" />
      <p class="hp"><label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label></p>
      <div class="field"><label for="c-page">Page (optional)</label><input id="c-page" name="page" type="text" /></div>
      <div class="field"><label for="c-msg">What should we fix or know?</label><textarea id="c-msg" name="message" required></textarea></div>
      <div class="field"><label for="c-email">Your email (optional, if you want a reply)</label><input id="c-email" name="email" type="email" autocomplete="email" inputmode="email" /></div>
      <button class="btn" type="submit" style="justify-self:start">Send</button>
    </form>
  </div>
  <script>
    const p = new URLSearchParams(location.search).get('page');
    if (p) (document.getElementById('c-page') as HTMLInputElement).value = p;
  </script>
</Base>
